---
// Every shared component on one page, with placeholder data, for keyboard,
// contrast, zoom and reduced-motion checks. Not linked and not indexed.
import Button from '../components/Button.astro';
import LastUpdated from '../components/LastUpdated.astro';
import LinkList from '../components/LinkList.astro';
import Notice from '../components/Notice.astro';
import Pager from '../components/Pager.astro';
import Table from '../components/Table.astro';
import Tabs from '../components/Tabs.astro';
import Base from '../layouts/Base.astro';

const colours = [
  { token: 'text', className: 'text-text', use: 'Body text, table cells' },
  { token: 'text-2', className: 'text-text-2', use: 'Nav links, subtitles' },
  { token: 'muted', className: 'text-muted', use: 'Updated, captions, "—"' },
  { token: 'accent', className: 'text-accent', use: 'Links, focus ring, active tab' },
];

const rows = [
  { rank: 1, name: 'Player 01', rating: 1412, games: 64, firsts: 21, active: '16 Nov' },
  { rank: 2, name: 'Player 02 with a much longer display name', rating: 1388, games: 1204, firsts: 17, active: '15 Nov' },
  { rank: 3, name: 'Player 03', rating: 1351, games: 38, firsts: 9, active: '2 Nov' },
];

const sizes = [
  { className: 'text-3xl font-bold', label: '3xl 40 px, h1 on desktop' },
  { className: 'text-2xl font-bold', label: '2xl 32 px, h1 on phone' },
  { className: 'text-xl font-semibold', label: 'xl 24 px' },
  { className: 'text-lg font-semibold', label: 'lg 20 px' },
  { className: 'text-base', label: 'base 16 px, body' },
  { className: 'text-sm', label: 'sm 14 px' },
];

const section = 'space-y-4 border-t border-border pt-8';
const heading = 'text-xl font-semibold';
---

<Base
  title="Style guide · CPL"
  description="Shared components with placeholder data."
  noindex
>
  <div class="space-y-10">
    <div class="max-w-reading space-y-4">
      <h1 class="text-2xl font-bold md:text-3xl">Style guide</h1>
      <p class="text-text-2">
        Every shared component, with placeholder data. Use it for the keyboard,
        contrast, zoom and reduced-motion checks in both themes.
      </p>
    </div>

    <section class={section} aria-labelledby="sg-colours">
      <h2 id="sg-colours" class={heading}>Colours</h2>
      <ul class="grid gap-4 md:grid-cols-2">
        {
          colours.map((colour) => (
            <li class="space-y-2">
              <p class={colour.className}>
                <span class="font-semibold">{colour.token}</span>: {colour.use}
              </p>
              <p class:list={['rounded-lg bg-surface px-3 py-2', colour.className]}>
                {colour.token} on surface
              </p>
            </li>
          ))
        }
      </ul>
      <p class="rounded-lg bg-accent px-3 py-2 text-on-accent">
        on-accent on accent: primary buttons
      </p>
      <p class="rounded-lg bg-notice-bg px-3 py-2 text-notice-text">
        notice-text on notice-bg: stale-data notice
      </p>
      <p class="border-b border-border pb-2 text-muted">
        border: dividers only (the line above), never the only sign of a control
      </p>
    </section>

    <section class={section} aria-labelledby="sg-type">
      <h2 id="sg-type" class={heading}>Type</h2>
      <ul class="space-y-3">
        {sizes.map((size) => <li class={size.className}>{size.label}</li>)}
      </ul>
      <p class="tabular-nums">Tabular figures: 1111 / 8888 / 1,204</p>
    </section>

    <section class={section} aria-labelledby="sg-buttons">
      <h2 id="sg-buttons" class={heading}>Buttons and theme</h2>
      <div class="flex flex-wrap gap-4">
        <Button href="/" variant="primary">Primary link</Button>
        <Button href="/">Secondary link</Button>
        <button type="button" data-theme-reset>Use device setting</button>
      </div>
      <p class="text-text-2">
        The theme button is in the header (in the menu on phones). "Use device
        setting" clears the saved choice.
      </p>
    </section>

    <section class={section} aria-labelledby="sg-tabs">
      <h2 id="sg-tabs" class={heading}>Tabs</h2>
      <Tabs
        label="Example tabs"
        items={[
          { label: 'Style guide', href: '/styleguide/' },
          { label: 'Home', href: '/' },
        ]}
      />
    </section>

    <section class={section} aria-labelledby="sg-table">
      <h2 id="sg-table" class={heading}>Table, notice and pager</h2>
      <Notice>Live data unavailable. Showing data from 17 Nov 2026.</Notice>
      <Table caption="Example ladder (placeholder data)">
        <thead>
          <tr>
            <th scope="col" class="num">#</th>
            <th scope="col">Player</th>
            <th scope="col" class="num">Rating</th>
            <th scope="col" class="num max-md:hidden">Games</th>
            <th scope="col" class="num">1st</th>
            <th scope="col" class="max-md:hidden">Last active</th>
          </tr>
        </thead>
        <tbody>
          {
            rows.map((row) => (
              <tr>
                <td class="num">{row.rank}</td>
                <th scope="row">{row.name}</th>
                <td class="num">{row.rating}</td>
                <td class="num max-md:hidden">{row.games.toLocaleString('en-GB')}</td>
                <td class="num">{row.firsts}</td>
                <td class="max-md:hidden">{row.active}</td>
              </tr>
            ))
          }
        </tbody>
      </Table>
      <p class="text-sm text-muted">Players need 3+ games to appear.</p>
      <Pager page={2} pages={7} prev="#sg-table" next="#sg-table" />
    </section>

    <section class={section} aria-labelledby="sg-links">
      <h2 id="sg-links" class={heading}>Link list and last updated</h2>
      <LinkList
        items={[
          {
            name: 'Better Balanced Game (BBG)',
            summary: 'Example summary line.',
            url: 'https://steamcommunity.com/sharedfiles/filedetails/?id=2865001760',
            destination: 'Steam Workshop',
          },
          {
            name: 'Multiplayer Helper (MPH)',
            summary: 'Example summary line.',
            url: 'https://steamcommunity.com/sharedfiles/filedetails/?id=3307282026',
            destination: 'Steam Workshop',
          },
        ]}
      />
      <LastUpdated date={new Date('2026-11-17')} />
    </section>

    <section class={section} aria-labelledby="sg-prose">
      <h2 id="sg-prose" class={heading}>Prose (Markdown pages)</h2>
      <div class="prose">
        <h3>A rules heading</h3>
        <p>
          Body text stays under 70 characters a line. Links look like
          <a href="/rules/general/">this link to the rules</a>, with an underline.
        </p>
        <ul>
          <li><strong>Bold</strong> for key words.</li>
          <li>A second point with <code>code</code>.</li>
        </ul>
        <ol>
          <li>Numbered step one.</li>
          <li>Numbered step two.</li>
        </ol>
        <blockquote>A quoted line.</blockquote>
      </div>
    </section>
  </div>
</Base>
