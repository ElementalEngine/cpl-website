---
import LinkCards from '../components/LinkCards.astro';
import Notice from '../components/Notice.astro';
import Section from '../components/Section.astro';
import Page from '../layouts/Page.astro';
import { getResources } from '../lib/content';

const { description, modsNote, mods, tools } = await getResources();

const withExtras = (items: typeof tools) =>
  items.map(({ links, ...item }) => ({
    ...item,
    extras: links.map((link) => ({ ...link, name: `${item.name}: ${link.label}` })),
  }));
---

<Page title="Resources" description={description} wide>
  <Fragment slot="sections">
    <Section title="Official mods">
      {modsNote && <Notice>{modsNote}</Notice>}
      <LinkCards items={withExtras(mods)} />
      <p class="text-text-2">
        Questions or bug reports about BBG? Join the BBG Discord, listed with our
        <a class="link" href="/about/#partner-communities">partner communities</a>.
      </p>
    </Section>
    <Section title="Tools">
      <LinkCards items={withExtras(tools)} />
    </Section>
  </Fragment>
</Page>
