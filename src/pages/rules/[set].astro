---
import type { InferGetStaticPropsType } from 'astro';
import { render } from 'astro:content';
import Tabs from '../../components/Tabs.astro';
import Page from '../../layouts/Page.astro';
import { getRuleSets } from '../../lib/content';
import { ruleTabs } from '../../lib/nav';

export async function getStaticPaths() {
  const sets = await getRuleSets();
  return sets.map(({ id, entry }) => ({ params: { set: id }, props: { entry } }));
}

type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const { entry } = Astro.props;
const { title, description, updatedOn } = entry.data;
const { Content } = await render(entry);
---

<Page
  title={title}
  documentTitle={`${title} · Rules · CPL`}
  description={description}
  updatedOn={updatedOn}
>
  <Tabs slot="tabs" label="Rule sets" items={ruleTabs()} />
  <Content />
</Page>
