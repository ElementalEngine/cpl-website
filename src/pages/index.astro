---
import Button from '../components/Button.astro';
import Base from '../layouts/Base.astro';
import { getHome, getSite } from '../lib/content';
import { gameLabel, shownGames } from '../lib/nav';

const site = await getSite();
const { intro, joinSteps } = await getHome();
const tournaments = shownGames(site)
  .filter((game) => site.games[game].tournaments)
  .map((game) => ({ label: `${gameLabel(game)} tournaments`, href: `/${game}/tournaments/` }));
const heading = 'text-xl font-semibold';
---

<Base title="CPL · Civilization Players League" description={intro}>
  <div class="space-y-12">
    <div class="max-w-reading space-y-6">
      <h1 class="text-2xl font-bold md:text-3xl">Civilization Players League</h1>
      <p class="text-lg text-text-2">{intro}</p>
      <Button href={site.discordInvite} variant="primary">Join Discord</Button>
    </div>

    <section data-reveal class="space-y-4" aria-labelledby="join">
      <h2 id="join" class={heading}>How to join</h2>
      <ol role="list" class="grid gap-4 md:grid-cols-3">
        {
          joinSteps.map((step, i) => (
            <li data-reveal class="flex gap-3 rounded-lg bg-surface p-4">
              <span aria-hidden="true" class="text-xl font-bold text-accent">
                {i + 1}
              </span>
              <p>{step}</p>
            </li>
          ))
        }
      </ol>
    </section>

    {
      tournaments.length > 0 && (
        <section data-reveal class="space-y-4" aria-labelledby="on-now">
          <h2 id="on-now" class={heading}>On now</h2>
          <p class="text-text-2">Leagues and cups running now, with their standings.</p>
          <ul>
            {tournaments.map((item) => (
              <li>
                <a class="link inline-flex min-h-11 items-center" href={item.href}>
                  {item.label}
                </a>
              </li>
            ))}
          </ul>
        </section>
      )
    }

    <section data-reveal class="max-w-reading space-y-4" aria-labelledby="ready">
      <h2 id="ready" class={heading}>Ready to play?</h2>
      <p class="text-text-2">Everything happens on Discord: games, sign-ups and results.</p>
      <Button href={site.discordInvite} variant="primary">Join Discord</Button>
    </section>
  </div>
</Base>
