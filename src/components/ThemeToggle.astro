---
// Shown only when scripts run (see .theme-toggle in global.css). Without
// scripts the device setting still applies through CSS.
---

<button
  type="button"
  class="theme-toggle size-11 items-center justify-center rounded-lg text-text-2 transition-colors duration-150 hover:text-text"
  aria-label="Switch theme"
  data-theme-toggle
>
  <svg
    aria-hidden="true"
    focusable="false"
    viewBox="0 0 24 24"
    width="22"
    height="22"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
  >
    <circle cx="12" cy="12" r="9"></circle>
    <path d="M12 3a9 9 0 0 1 0 18z" fill="currentColor" stroke="none"></path>
  </svg>
</button>

<script>
  import '../scripts/theme-toggle';
</script>
