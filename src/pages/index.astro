---
import Button from '../components/Button.astro';
import Base from '../layouts/Base.astro';
import { getSite } from '../lib/content';

const site = await getSite();
---

<Base
  title="CPL · Civilization Players League"
  description="The new website for the Civilization Players League is being built."
>
  <div class="max-w-reading space-y-6">
    <h1 class="text-2xl font-bold md:text-3xl">Civilization Players League</h1>
    <p class="text-lg text-text-2">
      The new CPL website is being built. Check back soon.
    </p>
    <Button href={site.discordInvite} variant="primary">Join Discord</Button>
  </div>
</Base>
