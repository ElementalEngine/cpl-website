---
import { Image } from 'astro:assets';
import logo from '../assets/brand/cpl-logo.png';
import Button from '../components/Button.astro';
import DataBlock from '../components/DataBlock.astro';
import StatTiles from '../components/StatTiles.astro';
import Table from '../components/Table.astro';
import Base from '../layouts/Base.astro';
import { getLadders, getOverview } from '../lib/core-api-data';
import { getHome, getSite } from '../lib/content';
import { overviewFacts, seasonFact } from '../lib/facts';
import { homeLeaders, ladderHref, ladderSubtitle, UNREGISTERED } from '../lib/ladders';
import {
  gameLabel,
  ruleTabs,
  sectionCards,
  shownGames,
  TOURNAMENT_TABS,
  tournamentGames,
  tournamentTabs,
} from '../lib/nav';
import { getTournaments } from '../lib/tournament-data';

const site = await getSite();
const { intro, highlights, joinSteps } = await getHome();
const games = tournamentGames(site);
const onNow = (
  await Promise.all(
    games.map(async (game) =>
      (await getTournaments(game)).active.map(({ id, data }) => {
        const tab = TOURNAMENT_TABS.find((item) => item.id === data.category) ?? TOURNAMENT_TABS[0];
        return {
          name: data.name,
          meta: [games.length > 1 && gameLabel(game), tab.label, data.format].filter(Boolean).join(' · '),
          href: `/${game}/tournaments/${tab.id}/#${id}`,
        };
      })
    )
  )
).flat();
const allTournaments = games.map((game) => ({
  label: `All ${gameLabel(game)} tournaments`,
  href: tournamentTabs(game)[0].href,
}));

const explore = [
  ...shownGames(site).flatMap((game) => sectionCards(site, game)),
  { name: 'Rules', href: ruleTabs()[0].href, text: 'Game, cloud, PL and Discord rules, with search.' },
  { name: 'Resources', href: '/resources/', text: 'The mods you need and the tools players use.' },
  { name: 'About CPL', href: '/about/', text: 'Who we are, partner communities and streamers.' },
];

// League totals and this season's top 10 per mode, for the first game with its Ladder on.
const ladderGame = shownGames(site).find((game) => site.games[game].ladder);
const totals = ladderGame ? await getOverview() : undefined;
const overview = totals?.kind === 'fresh' || totals?.kind === 'stale' ? totals.data : undefined;
const ladders = ladderGame ? await getLadders(ladderGame) : undefined;
const ladderData = ladders?.kind === 'fresh' || ladders?.kind === 'stale' ? ladders.data : undefined;
const leaders = ladderGame && ladderData ? homeLeaders(ladderGame, ladderData) : [];
const facts = [...(overview ? overviewFacts(overview) : []), ...(ladderData ? seasonFact(ladderData) : [])];
const firstLadder = ladderGame && leaders[0] ? ladderHref(ladderGame, leaders[0].mode.id) : undefined;

// Line icons for the highlights (24 × 24, stroked in the accent colour).
const ICONS = {
  ladder: 'M4 20V11M10 20V4M16 20v-6M22 20H2',
  trophy: 'M8 21h8M12 17v4M7 4h10v5a5 5 0 0 1-10 0zM7 6H4a3 3 0 0 0 3 4M17 6h3a3 3 0 0 1-3 4',
  chat: 'M21 12a8 8 0 0 1-11.6 7.1L4 20l1-4.6A8 8 0 1 1 21 12z',
} as const;

const heading = 'text-xl font-semibold';
const card = 'panel relative flex flex-col gap-1 rounded-lg border border-border bg-surface p-4';
---

<Base title="CPL · Civilization Players League" description={intro}>
  <div class="space-y-12">
    <div class="grid items-center gap-8 rounded-xl border border-border bg-surface p-6 md:p-10 lg:grid-cols-[3fr_2fr]">
      <div class="space-y-5">
        <p class="text-sm font-semibold tracking-wide text-accent uppercase">Civilization VI and VII multiplayer</p>
        <h1 class="text-2xl font-bold md:text-3xl">Civilization Players League</h1>
        <p class="max-w-reading text-lg text-text-2">{intro}</p>
        <div class="flex flex-wrap gap-3">
          <Button href={site.discordInvite} variant="primary">Join Discord</Button>
          {firstLadder && <Button href={firstLadder}>See the ladder</Button>}
        </div>
      </div>
      <Image
        src={logo}
        alt=""
        width={360}
        height={217}
        layout="none"
        loading="eager"
        class="mx-auto w-full max-w-60 lg:max-w-90"
      />
      {
        facts.length > 0 && (
          <div class="lg:col-span-2">
            <StatTiles facts={facts} onSurface />
          </div>
        )
      }
    </div>

    <section data-reveal class="space-y-4" aria-labelledby="offers">
      <h2 id="offers" class={heading}>What CPL offers</h2>
      <ul role="list" class="grid gap-6 md:grid-cols-3">
        {
          highlights.map((item) => (
            <li data-reveal class="flex gap-4">
              <span class="h-fit shrink-0 rounded-lg bg-surface p-3 text-accent">
                <svg
                  aria-hidden="true"
                  width="24"
                  height="24"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <path d={ICONS[item.icon]} />
                </svg>
              </span>
              <div class="space-y-1">
                <h3 class="font-semibold">{item.title}</h3>
                <p class="text-text-2">{item.text}</p>
              </div>
            </li>
          ))
        }
      </ul>
    </section>

    <section data-reveal class="space-y-4" aria-labelledby="join">
      <h2 id="join" class={heading}>How to join</h2>
      <ol role="list" class="grid gap-4 md:grid-cols-3">
        {
          joinSteps.map((step, i) => (
            <li data-reveal class="flex gap-3 rounded-lg bg-surface p-4">
              <span aria-hidden="true" class="text-xl font-bold text-accent">
                {i + 1}
              </span>
              <p>{step}</p>
            </li>
          ))
        }
      </ol>
    </section>

    {
      games.length > 0 && (
        <section data-reveal class="space-y-4" aria-labelledby="on-now">
          <h2 id="on-now" class={heading}>On now</h2>
          {onNow.length > 0 ? (
            <ul role="list" class="grid gap-4 md:grid-cols-2 lg:grid-cols-3">
              {onNow.map((item) => (
                <li data-reveal class={card}>
                  <a href={item.href} class="panel-link font-semibold text-text">
                    {item.name}
                  </a>
                  {item.meta && <p class="text-text-2">{item.meta}</p>}
                  <p aria-hidden="true" class="mt-auto pt-2 text-sm font-semibold text-accent">
                    Standings →
                  </p>
                </li>
              ))}
            </ul>
          ) : (
            <p class="text-text-2">No tournaments are running right now.</p>
          )}
          <ul>
            {allTournaments.map((item) => (
              <li>
                <a class="link inline-flex min-h-11 items-center" href={item.href}>
                  {item.label}
                </a>
              </li>
            ))}
          </ul>
        </section>
      )
    }

    {
      ladderGame && ladderData && ladders && leaders.length > 0 && (
        <section data-reveal class="space-y-4" aria-labelledby="leaders">
          <div class="space-y-1">
            <h2 id="leaders" class={heading}>Season leaders</h2>
            <p class="text-text-2">
              {gameLabel(ladderGame)} · {ladderSubtitle(ladderData, leaders[0].mode)}
            </p>
          </div>
          <DataBlock
            updated={new Date(ladderData.updated_at)}
            stale={ladders.kind === 'stale'}
            reportUrl={site.discordInvite}
          >
            <div class="grid gap-6 lg:grid-cols-3">
              {leaders.map(({ mode, rows, href }) => (
                <div class="space-y-2">
                  <h3 class="font-semibold">{mode.label}</h3>
                  <Table caption={`${mode.label}: top ${rows.length}`} hideCaption>
                    <thead>
                      <tr>
                        <th scope="col" class="num">#</th>
                        <th scope="col">Player</th>
                        <th scope="col" class="num">Rating</th>
                      </tr>
                    </thead>
                    <tbody>
                      {rows.map((row) => (
                        <tr>
                          <td class="num">{row.rank}</td>
                          <th
                            scope="row"
                            class:list={['player', row.display_name === UNREGISTERED && 'text-muted']}
                          >
                            {row.display_name}
                          </th>
                          <td class="num">{row.rating}</td>
                        </tr>
                      ))}
                    </tbody>
                  </Table>
                  <a class="link inline-flex min-h-11 items-center" href={href}>
                    Full {mode.label} ladder <span aria-hidden="true">&nbsp;→</span>
                  </a>
                </div>
              ))}
            </div>
          </DataBlock>
        </section>
      )
    }

    <section data-reveal class="space-y-4" aria-labelledby="explore">
      <h2 id="explore" class={heading}>Explore the site</h2>
      <ul role="list" class="grid gap-4 md:grid-cols-2 lg:grid-cols-3">
        {
          explore.map((item) => (
            <li data-reveal class={card}>
              <a href={item.href} class="panel-link font-semibold text-text">
                {item.name}
              </a>
              <p class="text-text-2">{item.text}</p>
            </li>
          ))
        }
      </ul>
    </section>
  </div>
</Base>
