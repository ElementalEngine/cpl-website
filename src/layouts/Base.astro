---
import { Font } from 'astro:assets';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { getSite } from '../lib/content';
import { themeInit } from '../lib/theme';
import '../styles/global.css';

interface Props {
  /** Full page title, e.g. "PL rules · Rules · CPL". */
  title: string;
  description: string;
  /** Keep the page out of search results (404, style guide). */
  noindex?: boolean;
}

const { title, description, noindex = false } = Astro.props;
const site = await getSite();
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const previewImage = new URL('/og-image.png', Astro.site).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline set:html={themeInit}></script>
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    {!noindex && <link rel="canonical" href={canonical} />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="CPL" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {!noindex && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={previewImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="CivPlayers League logo" />
    <meta name="theme-color" content="#a14421" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <Font cssVariable="--font-inter" preload />
    <script
      is:inline
      type="module"
      src="https://static.cloudflareinsights.com/beacon.min.js"
      data-cf-beacon='{"token": "4a8f63a6ae3e4f36a333b0f16af577f0"}'
    ></script>
  </head>
  <body class="flex min-h-dvh flex-col bg-bg font-sans text-text antialiased">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:top-2 focus:left-2 focus:z-10 focus:rounded-lg focus:bg-surface focus:px-4 focus:py-3 focus:font-semibold focus:text-text"
      >Skip to content</a
    >
    <Header site={site} />
    <main
      id="main"
      data-menu-inert
      class="mx-auto w-full max-w-page flex-1 px-4 py-8 md:px-6 md:py-12"
    >
      <slot />
    </main>
    <Footer site={site} />
    <script>
      import '../scripts/reveal';
    </script>
  </body>
</html>
