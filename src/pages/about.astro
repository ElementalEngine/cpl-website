---
import { render } from 'astro:content';
import LinkCards from '../components/LinkCards.astro';
import Section from '../components/Section.astro';
import Page from '../layouts/Page.astro';
import { getAbout } from '../lib/content';

const entry = await getAbout();
const { description, partnersIntro, partners, streamers } = entry.data;
const { Content } = await render(entry);

// The panel opens the Discord invite; a website is an extra link. A website-only partner opens the website.
const partnerItems = partners.map(({ invite, website, ...partner }) => ({
  ...partner,
  url: invite ?? website ?? '',
  extras:
    invite && website ? [{ label: 'Website', url: website, name: `${partner.name} website` }] : [],
}));
---

<Page title="About CPL" documentTitle="About CPL" description={description} wide>
  <Content />
  <Fragment slot="sections">
    <Section title="Partner communities">
      <p class="text-text-2">{partnersIntro}</p>
      <LinkCards items={partnerItems} />
    </Section>
    {
      streamers.length > 0 && (
        <Section title="Streamers">
          <LinkCards items={streamers} />
        </Section>
      )
    }
  </Fragment>
</Page>
