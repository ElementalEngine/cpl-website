---
// A panel's icon: the link's own image from src/content/icons/ (a mod's Workshop
// image, a Discord server's icon, a website's logo) when there is one, otherwise
// a plain line icon. Raster images are resized by Astro; SVG logos are used as is.
import { Image } from 'astro:assets';
import { contentIcon } from '../lib/content-icons';
import { iconKey, linkKind } from '../lib/links';
import LinkIcon from './LinkIcon.astro';

interface Props {
  url: string;
}

const { url } = Astro.props;
const { raster, svg } = contentIcon(iconKey(url));
const iconClass = 'panel-icon size-14 shrink-0 rounded-lg object-cover';
---

{
  raster ? (
    <Image src={raster} alt="" width={112} height={112} layout="none" class={iconClass} />
  ) : svg ? (
    <img src={svg} alt="" width="56" height="56" loading="lazy" class={iconClass} />
  ) : (
    <LinkIcon kind={linkKind(url)} />
  )
}
