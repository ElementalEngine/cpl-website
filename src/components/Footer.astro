---
import type { Site } from '../lib/site-schema';

interface Props {
  site: Site;
}

const { site } = Astro.props;
const groups = [
  { id: 'footer-follow', title: 'Follow:', kind: 'follow' },
  { id: 'footer-support', title: 'Support:', kind: 'support' },
]
  .map((group) => ({
    ...group,
    links: site.socials.filter((social) => social.kind === group.kind),
  }))
  .filter((group) => group.links.length > 0);

// min-w-11 keeps short labels like "X" at a 44 px target.
const link =
  'inline-flex min-h-11 min-w-11 items-center justify-center text-text-2 underline-offset-4 hover:text-text hover:underline';
---

<footer data-menu-inert class="border-t border-border bg-surface text-sm">
  <div
    class="mx-auto flex max-w-page flex-wrap items-center gap-x-6 px-4 md:px-6"
  >
    <ul class="flex flex-wrap gap-x-4">
      <li><a class={link} href={site.discordInvite}>Join Discord</a></li>
      <li><a class={link} href="/about/">About</a></li>
      <li><a class={link} href="/privacy/">Privacy</a></li>
    </ul>
    {
      groups.map((group) => (
        <div class="flex flex-wrap items-center gap-x-3">
          <p id={group.id} class="text-muted">
            {group.title}
          </p>
          <ul aria-labelledby={group.id} class="flex flex-wrap gap-x-3">
            {group.links.map((social) => (
              <li>
                <a class={link} href={social.url}>
                  {social.name}
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))
    }
    <p class="text-muted">© CPL</p>
  </div>
</footer>
