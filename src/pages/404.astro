---
import Base from '../layouts/Base.astro';
import { getSite } from '../lib/content';
import { gameLabel, gameSections, ruleTabs, shownGames } from '../lib/nav';

const site = await getSite();
const links = [
  { label: 'Home', href: '/' },
  ...shownGames(site).flatMap((game) =>
    gameSections(site, game).map((section) => ({
      label: `${gameLabel(game)} ${section.label.toLowerCase()}`,
      href: section.href,
    }))
  ),
  { label: 'Rules', href: ruleTabs()[0].href },
];
---

<Base
  title="Page not found · CPL"
  description="This page could not be found."
  noindex
>
  <div class="max-w-reading space-y-6">
    <h1 class="text-2xl font-bold md:text-3xl">Page not found</h1>
    <p>It may have moved, or it no longer exists.</p>
    <ul class="space-y-1">
      {
        links.map((link) => (
          <li>
            <a class="link inline-flex min-h-11 items-center" href={link.href}>
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</Base>
