---
import logo from '../assets/brand/logo.png';
import Button from './Button.astro';
import ThemeToggle from './ThemeToggle.astro';
import { mainNav, navCurrent } from '../lib/nav';
import type { Site } from '../lib/site-schema';

interface Props {
  site: Site;
}

const { site } = Astro.props;
const { pathname } = Astro.url;
const items = mainNav(site);
---

<header class="site-header border-b border-border bg-surface">
  <div
    class="mx-auto flex max-w-page flex-wrap items-center gap-x-2 px-4 py-2 md:px-6"
  >
    <a href="/" class="me-2 inline-flex rounded-lg">
      <img
        src={logo.src}
        width="73"
        height="44"
        alt="CivPlayers League home"
      />
    </a>

    <!-- Phone: drops below the header row as the menu drawer. lg: inline. -->
    <nav
      id="site-nav"
      aria-label="Main"
      class="site-nav order-last basis-full lg:order-none lg:ms-auto lg:basis-auto"
    >
      <ul
        class="flex flex-col border-t border-border py-2 lg:flex-row lg:items-center lg:gap-1 lg:border-0 lg:py-0"
      >
        {
          items.map((item) => {
            const current = navCurrent(item.href, pathname);
            return (
              <li>
                <a
                  href={item.href}
                  aria-current={current}
                  class:list={[
                    'nav-link flex min-h-11 items-center rounded-lg px-3 underline-offset-8 transition-colors duration-150 hover:text-text',
                    current
                      ? 'font-semibold text-text underline decoration-accent decoration-2'
                      : 'text-text-2',
                  ]}
                >
                  {item.label}
                </a>
              </li>
            );
          })
        }
        <li class="lg:ms-1"><ThemeToggle /></li>
      </ul>
    </nav>

    <Button href={site.discordInvite} variant="primary" class="ms-auto lg:ms-2">
      Join Discord
    </Button>

    <button
      type="button"
      class="menu-button size-11 items-center justify-center rounded-lg text-text-2 hover:text-text"
      aria-expanded="false"
      aria-controls="site-nav"
      data-menu-button
    >
      <span class="sr-only">Menu</span>
      <svg
        aria-hidden="true"
        focusable="false"
        viewBox="0 0 24 24"
        width="24"
        height="24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
      >
        <path class="menu-icon-open" d="M4 7h16M4 12h16M4 17h16"></path>
        <path class="menu-icon-close" d="M6 6l12 12M18 6L6 18"></path>
      </svg>
    </button>
  </div>
</header>

<script>
  import '../scripts/menu';
</script>
