{
  "name": "cpl-website",
  "private": true,
  "version": "0.1.0",
  "description": "Public website for the Civilization Players League (CPL)",
  "type": "module",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=24.18.0"
  },
  "scripts": {
    "dev": "astro dev",
    "check": "astro check",
    "lint": "eslint . --max-warnings=0",
    "test": "node --import tsx --test",
    "knip": "knip",
    "build": "astro build",
    "contracts:check": "tsx scripts/contracts-check.ts",
    "contracts:update": "tsx scripts/contracts-update.ts",
    "a11y": "tsx scripts/a11y.ts",
    "icons": "tsx scripts/fetch-icons.ts",
    "challonge": "tsx scripts/challonge-check.ts",
    "core-api": "tsx scripts/core-api-check.ts",
    "verify": "npm run check && npm run lint && npm run test && npm run knip && npm run build && npm run contracts:check && npm run a11y",
    "deploy": "wrangler deploy"
  },
  "prettier": {
    "printWidth": 80,
    "singleQuote": true,
    "trailingComma": "es5",
    "arrowParens": "always",
    "endOfLine": "auto"
  },
  "dependencies": {
    "@tailwindcss/vite": "4.3.5",
    "astro": "7.4.13",
    "tailwindcss": "4.3.5"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@types/node": "24.19.2",
    "axe-core": "4.14.1",
    "eslint": "10.15.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-astro": "3.2.1",
    "knip": "6.46.1",
    "puppeteer-core": "25.18.1",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0",
    "wrangler": "4.165.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "workerd@1.20261117.1": true
  }
}
