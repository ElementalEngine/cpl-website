---
// A plain line icon for a kind of link. Decorative: the text beside it says where the link goes.
import type { LinkKind } from '../lib/links';

interface Props {
  kind: LinkKind;
}

const { kind } = Astro.props;
---

<span
  aria-hidden="true"
  class="panel-icon inline-flex size-14 shrink-0 items-center justify-center rounded-lg bg-bg text-accent"
>
  <svg
    focusable="false"
    viewBox="0 0 24 24"
    width="28"
    height="28"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
  >
    {
      kind === 'mod' && (
        <>
          <path d="M21 8 12 3 3 8v8l9 5 9-5z" />
          <path d="m3 8 9 5 9-5M12 13v8" />
        </>
      )
    }
    {
      kind === 'discord' && (
        <path d="M21 12a8 8 0 0 1-11.6 7.1L4 20l1-4.6A8 8 0 1 1 21 12z" />
      )
    }
    {
      kind === 'video' && (
        <>
          <rect x="2" y="6" width="14" height="12" rx="2" />
          <path d="m22 8-6 4 6 4z" />
        </>
      )
    }
    {kind === 'code' && <path d="m8 7-5 5 5 5M16 7l5 5-5 5" />}
    {
      kind === 'web' && (
        <>
          <circle cx="12" cy="12" r="9" />
          <path d="M3 12h18M12 3a14 14 0 0 1 0 18M12 3a14 14 0 0 0 0 18" />
        </>
      )
    }
  </svg>
</span>
