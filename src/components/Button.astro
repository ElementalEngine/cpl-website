---
import type { HTMLAttributes } from 'astro/types';

interface Props extends HTMLAttributes<'a'> {
  href: string;
  variant?: 'primary' | 'secondary';
}

const { variant = 'secondary', class: className, ...attrs } = Astro.props;
---

<a
  {...attrs}
  class:list={[
    'btn inline-flex min-h-11 items-center justify-center rounded-lg px-4 font-semibold whitespace-nowrap no-underline underline-offset-4 hover:underline',
    variant === 'primary'
      ? 'bg-accent text-on-accent'
      : 'border-2 border-accent text-accent',
    className,
  ]}><slot /></a
>
