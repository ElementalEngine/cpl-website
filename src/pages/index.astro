---
import Button from '../components/Button.astro';
import Base from '../layouts/Base.astro';
import { getHome, getSite } from '../lib/content';
import { gameLabel, tournamentGames } from '../lib/nav';
import { getTournaments } from '../lib/tournament-data';

const site = await getSite();
const { intro, joinSteps } = await getHome();
const games = tournamentGames(site);
const onNow = (
  await Promise.all(
    games.map(async (game) =>
      (await getTournaments(game)).active.map(({ id, data }) => ({
        name: data.name,
        meta: [games.length > 1 && gameLabel(game), data.format].filter(Boolean).join(' · '),
        href: `/${game}/tournaments/#${id}`,
      }))
    )
  )
).flat();
const allTournaments = games.map((game) => ({
  label: `All ${gameLabel(game)} tournaments`,
  href: `/${game}/tournaments/`,
}));
const heading = 'text-xl font-semibold';
---

<Base title="CPL · Civilization Players League" description={intro}>
  <div class="space-y-12">
    <div class="max-w-reading space-y-6">
      <h1 class="text-2xl font-bold md:text-3xl">Civilization Players League</h1>
      <p class="text-lg text-text-2">{intro}</p>
      <Button href={site.discordInvite} variant="primary">Join Discord</Button>
    </div>

    <section data-reveal class="space-y-4" aria-labelledby="join">
      <h2 id="join" class={heading}>How to join</h2>
      <ol role="list" class="grid gap-4 md:grid-cols-3">
        {
          joinSteps.map((step, i) => (
            <li data-reveal class="flex gap-3 rounded-lg bg-surface p-4">
              <span aria-hidden="true" class="text-xl font-bold text-accent">
                {i + 1}
              </span>
              <p>{step}</p>
            </li>
          ))
        }
      </ol>
    </section>

    {
      games.length > 0 && (
        <section data-reveal class="space-y-4" aria-labelledby="on-now">
          <h2 id="on-now" class={heading}>On now</h2>
          {onNow.length > 0 ? (
            <ul role="list" class="grid gap-4 md:grid-cols-2 lg:grid-cols-3">
              {onNow.map((item) => (
                <li
                  data-reveal
                  class="panel relative flex flex-col gap-1 rounded-lg border border-border bg-surface p-4"
                >
                  <a href={item.href} class="panel-link font-semibold text-text">
                    {item.name}
                  </a>
                  {item.meta && <p class="text-text-2">{item.meta}</p>}
                  <p aria-hidden="true" class="mt-auto pt-2 text-sm font-semibold text-accent">
                    Standings →
                  </p>
                </li>
              ))}
            </ul>
          ) : (
            <p class="text-text-2">No tournaments are running right now.</p>
          )}
          <ul>
            {allTournaments.map((item) => (
              <li>
                <a class="link inline-flex min-h-11 items-center" href={item.href}>
                  {item.label}
                </a>
              </li>
            ))}
          </ul>
        </section>
      )
    }

    <section data-reveal class="max-w-reading space-y-4" aria-labelledby="ready">
      <h2 id="ready" class={heading}>Ready to play?</h2>
      <p class="text-text-2">Everything happens on Discord: games, sign-ups and results.</p>
      <Button href={site.discordInvite} variant="primary">Join Discord</Button>
    </section>
  </div>
</Base>
